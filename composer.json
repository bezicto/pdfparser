{
    "name": "bezicto/pdfparser",
    "description": "Standalone PHP PDF parser library to extract text, metadata, and page details with low memory usage.",
    "keywords": ["PDF", "text", "parser", "parse", "extract", "php"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Khairul Asyrani bin Sulaiman",
            "email": "bezicto@gmail.com",
            "homepage": "https://github.com/bezicto",
            "role": "Maintainer"
        },
        {
            "name": "Sebastien MALOT",
            "email": "sebastien@malot.fr",
            "role": "Original Author"
        }
    ],
    "support": {
        "issues": "https://github.com/bezicto/pdfparser/issues",
        "source": "https://github.com/bezicto/pdfparser"
    },
    "homepage": "https://github.com/bezicto/pdfparser",
    "require": {
        "php": ">=7.1",
        "symfony/polyfill-mbstring": "^1.18",
        "ext-zlib": "*",
        "ext-iconv": "*"
    },
    "replace": {
        "smalot/pdfparser": "*"
    },
    "autoload": {
        "psr-4": {
            "Smalot\\PdfParser\\": "src/Smalot/PdfParser/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PerformanceTests\\": "tests/Performance/",
            "PHPUnitTests\\": "tests/PHPUnit/"
        }
    },
    "config": {
        "process-timeout": 1200
    }
}
